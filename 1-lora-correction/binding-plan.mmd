flowchart LR
  classDef plain fill:#ffffff,stroke:#222222,stroke-width:2px,color:#111111
  subgraph NOW["Now: the LoRA alone (Z10, weight 1)"]
    N1["plain product<br/>of 'a fox' and 'a llama'"]:::plain --> N2["+ the LoRA's correction<br/>everywhere"]:::plain --> N3["two bodies, both llamas<br/>(26 of 32 two bodies,<br/>2 of 32 two clear)"]:::plain
  end
  subgraph NEXT["Option A: the LoRA plus each animal's own prediction in its box"]
