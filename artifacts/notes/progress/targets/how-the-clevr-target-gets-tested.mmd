%%{init: {'theme': 'base', 'themeVariables': {'fontFamily': 'monospace', 'primaryColor': '#ffffff', 'primaryBorderColor': '#222222', 'primaryTextColor': '#111111', 'lineColor': '#222222'}}}%%
flowchart TD
    subgraph DATA["Data: move up only when the cheaper rung works"]
        direction LR
        R1["1. Du's cubes<br/>64 pixels, 6.2 GB<br/>no Blender"] --> R2["2. CLEVR, one object<br/>64 pixels<br/>about 15 GPU-hours"] --> R3["3. CLEVR, one object<br/>128 pixels, Bradley's size<br/>cost not known yet"]
    end
    DATA --> M["Train two models that only ever see one object<br/>location model + empty-background model"]
    M --> L["Bradley's rule<br/>add the scores"]
    M -. "after the checker is chosen (D3)" .-> O["Our method<br/>product + checker"]
    L --> S["Ask for 1, 2, 3 ... 10 objects<br/>1,024 images per count, same positions and seeds"]
    O -.-> S
    S --> C["Score each count K<br/>all K objects in at least 50% of images<br/>at least K-2 in at least 90%<br/>and the picture stays clean"]
    C --> K{"Most objects<br/>that succeed?"}
    K -- "5 or fewer" --> F["No win<br/>report where it breaks"]
    K -- "6 or more at 64 pixels" --> B["Promising<br/>rerun at 128 pixels"]
    K -- "6 or more at 128 pixels" --> W["Beats the printed 5<br/>9 or 10 would be far past it"]

    classDef plain fill:#ffffff,stroke:#222222,stroke-width:2px,color:#111111
    classDef win fill:#b7efc5,stroke:#222222,stroke-width:2px,color:#111111
    classDef stop fill:#ffd6a5,stroke:#e8590c,stroke-width:2px,color:#111111
    class R1,R2,R3,M,L,O,S,C,K,B plain
    class W win
    class F stop
    style DATA fill:#eaf1ff,stroke:#a8c7fa,stroke-width:3px
