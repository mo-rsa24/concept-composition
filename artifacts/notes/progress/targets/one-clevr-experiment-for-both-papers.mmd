%%{init: {'theme': 'base', 'themeVariables': {'fontFamily': 'monospace', 'primaryColor': '#ffffff', 'primaryBorderColor': '#222222', 'primaryTextColor': '#111111', 'lineColor': '#222222'}}}%%
flowchart TD
    D["Same CLEVR setup for every method<br/>same positions and seeds, 1 to 10 objects"]
    subgraph ONE["Nothing sees an image with two real objects: target 7 objects, at equal training length"]
        direction LR
        B["Control: Bradley's rule<br/>one location network<br/>printed: all 6 in 97 of 100"]
        P2["Paper 2<br/>same one network<br/>+ our checker"]
        E["Experts trained apart<br/>no checker"]
        P1["Paper 1<br/>experts trained apart<br/>+ our checker"]
        C["Control: sample and paste<br/>each expert alone"]
    end
    subgraph TWO["Two experts holding several objects: its own table"]
        direction LR
        A["Model A<br/>1, 2 or 3 red objects"]
        R["Model B<br/>1, 2 or 3 blue objects"]
    end
    S["One scorer for all<br/>most objects that succeed<br/>all N in place, picture quality"]
    B ~~~ P2 ~~~ E ~~~ P1 ~~~ C
    A ~~~ R
    D --> ONE
    ONE --> S
    D -. "separate table" .-> TWO
    TWO -.-> S

    classDef plain fill:#ffffff,stroke:#222222,stroke-width:2px,color:#111111
    class D,B,P2,E,P1,C,A,R,S plain
    style ONE fill:#eaf1ff,stroke:#a8c7fa,stroke-width:3px
    style TWO fill:#fff4e6,stroke:#e8a15c,stroke-width:2px
