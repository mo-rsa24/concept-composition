%%{init: {'theme': 'base', 'themeVariables': {'fontFamily': 'monospace', 'primaryColor': '#ffffff', 'primaryBorderColor': '#222222', 'primaryTextColor': '#111111', 'lineColor': '#222222'}}}%%
flowchart TB
  classDef plain fill:#ffffff,stroke:#222222,stroke-width:2px,color:#111111
  classDef done fill:#dcf5dc,stroke:#2e7d32,stroke-width:2px,color:#111111
  classDef now fill:#eaf1ff,stroke:#a8c7fa,stroke-width:3px,color:#111111
  classDef held fill:#ffffff,stroke:#c62828,stroke-width:2px,stroke-dasharray:5 4,color:#111111
  classDef settled fill:#fff3cd,stroke:#b58900,stroke-width:2px,color:#111111

  M1["M1, done: neither method beats its baseline<br/>Paper 1 ties paste, Paper 2 ties CO3"]
  M7["M7, done: paste places every object<br/>on separated CLEVR, 1,024 of 1,024"]
  M5["NOW, M5: balance the checker's data"]
  D3["D3: what should the checker read?<br/>includes the unseen-category test"]
  M2["M2: pair-aware or one label per subject?"]
  D5["D5: push on the 2 saved inclusive LoRAs"]
  M3["M3: tune strength, steps, cap, data size"]
  M10["M10: two colour experts, told what, not where<br/>Paper 1's test where pasting cannot place objects"]
  M8["M8: Loop 6's checker against Loop 8's"]
  M4["M4: freeze one recipe per paper"]
  M9["M9, held: give each subject its own region<br/>8 of 8 clear only with oracle boxes, all damaged<br/>both box readers missed their limit"]

  Q85["Open question 85: check the checker reads<br/>CO3's failure, judge with style ignored,<br/>add a mask-paste row to M10?"]
  Q83["Open question 83:<br/>close M9?"]
  Q84["Your answer, question 84:<br/>M10 takes M6's place"]
  Q57["Your answer, question 57:<br/>the CO3 rows decide M5 and D3"]

  M1 --> M7 --> M5 --> D3 --> M2 --> M3 --> M10 --> M8 --> M4
  M2 --> D5
  M9 --> M4
  Q85 -.-> M5
  Q85 -.-> M10
  Q83 -.-> M9
  Q84 -.-> M10
  Q57 -.-> M5

  class D3,M2,D5,M3,M10,M8,M4 plain
  class M1,M7 done
  class M5 now
  class M9,Q85,Q83 held
  class Q84,Q57 settled
