%%{init: {'theme': 'base', 'themeVariables': {'fontFamily': 'monospace', 'primaryColor': '#ffffff', 'primaryBorderColor': '#222222', 'primaryTextColor': '#111111', 'lineColor': '#222222'}}}%%
flowchart TB
  classDef done fill:#d9f2e3,stroke:#1d7a3e,stroke-width:2px,color:#111111
  classDef doing fill:#ffe3bf,stroke:#c86a0a,stroke-width:3px,color:#111111
  classDef todo fill:#eeeeee,stroke:#777777,stroke-width:2px,color:#111111
  classDef ask fill:#fff3cd,stroke:#b58900,stroke-width:2px,color:#111111

  subgraph L6["Loop 6: find the best method for each paper"]
    direction LR
    M1["DONE, M1: neither method beat its baseline<br/>CO3 already draws two bodies, 96 of 96"]:::done
    M7["DONE, M7: paste places every object<br/>on separated CLEVR, 1,024 of 1,024"]:::done
    M5["NOW, M5: checker data,<br/>CO3 rows decide"]:::doing
    Q85["YOUR CALL, question 85:<br/>check the checker reads CO3's failure first?"]:::ask
    M10["M10: two colour experts,<br/>told what, not where"]:::todo
    M1 --> M7 --> M5
    Q85 -.-> M5
    M7 --> M10
  end

  subgraph L7["Loop 7: read and design"]
    direction LR
    U["DONE: 25 papers read, 5 checkers designed.<br/>Only the spatial checker has a trained precedent on unseen concepts"]:::done
  end

  subgraph L8["Loop 8: test abstract checkers on digits"]
    direction LR
    V2["DONE, V2: the count checker reads<br/>unseen digits, 0.782 and 0.791;<br/>the identity checker misses, 0.555"]:::done
    V3["DONE, V3: its push draws 43 clean<br/>pairs of 320 on unseen digits, against 0"]:::done
    V6["NOW, V6: an identity checker<br/>that reads which digits"]:::doing
    V4["V4: on SDXL's unseen objects"]:::todo
    V2 --> V3 --> V6 --> V4
  end

  P["Paper 2 at real-world scale"]:::todo
  U -->|"design"| V2
  V3 -->|"count checker"| M10
  M1 -.->|"identity, not plurality, is CO3's gap"| V6
  M5 --> P
  V4 -.-> P

  style L6 fill:#fafafa,stroke:#222222,stroke-width:1px
  style L7 fill:#fafafa,stroke:#222222,stroke-width:1px
  style L8 fill:#fafafa,stroke:#222222,stroke-width:1px
