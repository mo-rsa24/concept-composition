flowchart TB
  X["half-drawn SDXL latent x_t<br/>4 x 128 x 128, steps 0 to 15 of 50"]:::input
  S["right: a photo of a puma and a condor<br/>wrong: a photo of two pumas, ..."]:::input
  M["fixed linear map to RGB, clamp 0 to 255<br/>resize to 224 x 224"]:::fixed
  V["NoisyCLIP image encoder, ViT-L/14<br/>tuned on noisy SDXL latents 20 to 29"]:::image
