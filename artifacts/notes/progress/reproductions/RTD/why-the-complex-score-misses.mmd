        C["Update at zero<br/>matches plain SDXL, difference 0.0"]:::plain
        D["Code and settings<br/>authors' pipeline at 241eb37"]:::plain
        E["The pictures<br/>8 random prompts render cleanly"]:::plain
    end

    subgraph OPEN["Still open, nothing run separates them"]
        direction TB
        F["Hardware<br/>their H200, our RTX 3090s"]:::open
        G["ImageReward<br/>package or preprocessing unstated"]:::open
        H["The printed number itself<br/>0.466 may not come from this code"]:::open
