# Python bytecode and virtualenvs
*pycache*/
*.pyc
.venv/
venv/

# Training artifacts
*.npy
*.pt
*.safetensors
wandb/

# Pilot data (lives under /datasets/...)
dataset/

# Editor / IDE local state
claude/
.claude/*
# Shared project config is tracked: the hooks and the project skills are part of
# how this repo is worked, not personal editor state.
!.claude/settings.json
!.claude/skills/
.idea/
.vscode/local/

# Local results — symlinks point at /datasets/mmolefe/poe_repair_min/outputs/
outputs/*
!outputs/INDEX.md
logs/

# Generated run artifacts (regenerable; large; canonical copies live under /datasets/mmolefe).
# Source content that lives under artifacts/ by the four-folder convention (drips, scenes,
# notes, decks, videos, and their READMEs) is tracked; only the run-output kinds are ignored.
artifacts/results/
artifacts/caches/
artifacts/rung2-survive-noise/
artifacts/rung3-group-wise/
artifacts/rung4-scale/
artifacts/_quarantine/
results/

# Papers / reference PDFs (not source)
# *.pdf

# Misc transient
.DS_Store
*.tmp
writing/*-overleaf*.zip

# Built scene apps: dist bundles and dependencies are regenerable from the source
# beside them (npm install && npm run build). The source is tracked; these are not.
artifacts/scenes/*/dist/
artifacts/scenes/*/node_modules/
artifacts/scenes/*/app/dist/
artifacts/scenes/*/app/node_modules/

# Codex render attempts and transcripts land here per render-diagrams; the folder is
# disposable by convention and only passing images are copied out to a diagrams/ path.
temp/

# The Overleaf project's git bridge, cloned as its own repository. It is a
# transfer point between writing/iclr and Overleaf, not a second workspace, and
# it carries a history the project repo must not nest inside its own.
# writing/overleaf-iclr/

# The ICLR 56173 Overleaf export: source tracked, figures, builds and PDFs kept out (Overleaf holds them)
writing/restoring-plurality-in-compositional-diffusion_overleaf/figures/
writing/restoring-plurality-in-compositional-diffusion_overleaf/final_figures/
writing/restoring-plurality-in-compositional-diffusion_overleaf/ablation/
writing/restoring-plurality-in-compositional-diffusion_overleaf/superdiff stuff/
writing/restoring-plurality-in-compositional-diffusion_overleaf/build/
writing/restoring-plurality-in-compositional-diffusion_overleaf/**/*.pdf

# browser-tool screenshots, archived 2026-11-13
.playwright-mcp/
# the Overleaf project, its own git repo (remote: https://git.overleaf.com/6a86dc92ca15fe47d75b86f6)
writing/overleaf-iclr/

# each project's data folder (large; canonical copies under /datasets/mmolefe)
/[0-9]-*/data/

# COCO 2017 annotations and the cat/dog photos pulled from it (rung 2 checker data)
data/coco-2017/
# Open Images V7 boxes and the cat/dog photos pulled from it (rung 2 checker data)
data/open-images-v7/
# Re-LAION-2B cat/dog candidates and images (rung 2 checker data)
data/relaion-catdog/
# MNIST canvases, checkpoints and samples for the inclusive-captions MNIST stage (route step 4)
data/mnist/

# The progress board's lock files
artifacts/notes/progress/.*.lock
artifacts/notes/progress/board.tmp
