 "p_sigma_d": [
  "d",
  "\\begin{aligned} p &= \\sigma(\\ell) = \\frac{1}{1+e^{-\\ell}} \\\\[4pt] \\ell &= \\log\\frac{p}{1-p} \\end{aligned}"
 ],
 "cg_d": [
  "d",
  "\\begin{aligned} \\nabla_{x_t} \\log p(\\text{two apart} \\mid x_t) &= (1-p)\\, \\nabla_{x_t} \\ell \\\\ &= (1-p)\\, g \\end{aligned}"
 ],
 "dir_d": [
