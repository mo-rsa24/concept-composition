{
 "_about": "Every equation and math symbol on the page, as TeX. build_page.py renders each with KaTeX 0.16.11 at build time; the page reads the rendered HTML from EQ by name. 'd' = display (own line), 'i' = inline.",
 "xt_d": [
  "d",
  "x_t = \\sqrt{\\bar\\alpha_t}\\,x_0 + \\sqrt{1-\\bar\\alpha_t}\\,\\varepsilon"
 ],
 "map_d": [
  "d",
  "m_a = 2048 \\cdot \\frac{|\\varepsilon_a - \\varepsilon_\\varnothing|}{\\sum_{\\text{pixels}} |\\varepsilon_a - \\varepsilon_\\varnothing|}"
 ],
 "map_mini_d": [
  "d",
  "m_a = 4 \\cdot \\frac{|\\varepsilon_a - \\varepsilon_\\varnothing|}{\\sum_{i=1}^{4} |\\varepsilon_a - \\varepsilon_\\varnothing|_i}"
 ],
 "expert_mini_d": [
  "d",
  "\\varepsilon_\\varnothing = 0.9\\,x, \\qquad \\varepsilon_y - \\varepsilon_\\varnothing = -0.5\\,T_y\\,\\sigma(3x)"
 ],
 "convsize_d": [
  "d",
  "n_{\\text{out}} = \\left\\lfloor \\frac{n_{\\text{in}} + 2p - k}{s} \\right\\rfloor + 1"
 ],
 "conv_real_d": [
  "d",
  "\\begin{aligned} z_{c,i,j} &= b_c + \\sum_{c'} \\sum_{u=0}^{2} \\sum_{v=0}^{2} W_{c,c',u,v}\\, h^{\\text{in}}_{c',\\, s i + u - p,\\, s j + v - p} \\\\ h_{c,i,j} &= \\operatorname{SiLU}(z_{c,i,j}) \\end{aligned}"
 ],
 "conv_mini_d": [
  "d",
  "\\text{pre}_c = \\text{bias}_c + \\sum_{m \\in \\{a,b\\}} \\sum_{k=1}^{2} K_{c,m,k}\\, m_k"
 ],
 "silu_d": [
  "d",
  "\\operatorname{SiLU}(z) = z\\,\\sigma(z) = \\frac{z}{1+e^{-z}}"
 ],
 "film_d": [
  "d",
  "h \\leftarrow h\\,(1+\\gamma) + \\beta"
 ],
 "film_mini_d": [
  "d",
  "\\begin{gathered} h = \\operatorname{SiLU}(\\text{pre})\\,(1+\\gamma) + \\beta \\\\ \\gamma = W_\\gamma\\,\\phi, \\qquad \\beta = W_\\beta\\,\\phi \\end{gathered}"
 ],
 "phi_mini_d": [
  "d",
  "\\phi = \\Big(\\sin\\tfrac{\\lambda}{10},\\ \\cos\\tfrac{\\lambda}{10}\\Big), \\qquad \\lambda = \\log\\frac{\\bar\\alpha_t}{1-\\bar\\alpha_t}"
 ],
 "phi_d": [
  "d",
  "\\phi_k = \\sin\\Big(\\omega_k\\,\\tfrac{\\lambda}{10}\\Big), \\quad \\phi_{8+k} = \\cos\\Big(\\omega_k\\,\\tfrac{\\lambda}{10}\\Big), \\quad \\omega_k = e^{3k/7}"
 ],
 "lambda_def": [
  "i",
  "\\lambda = \\log\\frac{\\bar\\alpha_t}{1-\\bar\\alpha_t}"
 ],
 "pool_d": [
  "d",
  "\\begin{gathered} \\text{mean}_c = \\frac{1}{8 \\cdot 16} \\sum_{i} h_{c,i} \\\\ \\text{max}_c = \\max_i h_{c,i} \\end{gathered}"
 ],
 "readout_d": [
  "d",
  "\\begin{aligned} \\ell &= v \\cdot (\\text{mean}_1, \\text{mean}_2, \\text{max}_1, \\text{max}_2) \\\\ &\\quad + u \\cdot \\phi + c \\end{aligned}"
 ],
 "mlp_d": [
  "d",
  "\\ell = W_2\\, \\operatorname{SiLU}\\big(W_1 [\\text{pooled};\\, \\phi] + b_1\\big) + b_2"
 ],
 "sigma_d": [
  "d",
  "\\sigma(\\ell) = \\frac{1}{1+e^{-\\ell}}"
 ],
 "bce_d": [
  "d",
  "L = -\\big[\\,y \\log \\sigma(\\ell) + (1-y) \\log(1-\\sigma(\\ell))\\,\\big]"
 ],
 "chain_d": [
  "d",
  "\\begin{gathered} \\frac{\\partial L}{\\partial K} = \\frac{\\partial L}{\\partial \\ell}\\, \\frac{\\partial \\ell}{\\partial h}\\, \\frac{\\partial h}{\\partial\\, \\text{pre}}\\, \\frac{\\partial\\, \\text{pre}}{\\partial K} \\\\ \\frac{\\partial L}{\\partial \\ell} = \\sigma(\\ell) - y \\end{gathered}"
 ],
 "step_d": [
  "d",
  "K \\leftarrow K - 0.05 \\cdot \\tfrac12 \\sum_{n=1}^{2} \\frac{\\partial L_n}{\\partial K}"
 ],
 "push_g_d": [
  "d",
  "g = \\nabla_{x_t} \\ell"
 ],
 "product_d": [
  "d",
  "\\varepsilon_{\\text{product}} = \\varepsilon_a + \\varepsilon_b - \\varepsilon_\\varnothing"
 ],
 "push_d": [
  "d",
  "\\hat\\varepsilon = \\varepsilon_{\\text{product}} - \\lVert \\varepsilon_{\\text{product}} \\rVert \\, b \\, \\frac{g}{\\lVert g \\rVert}"
 ],
